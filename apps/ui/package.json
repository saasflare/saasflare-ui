{
  "name": "@saasflare/ui-app",
  "version": "1.0.0",
  "private": true,
  "description": "Saasflare UI Catalog – ui.saasflare.io",
  "scripts": {
    "dev": "next dev --turbopack --port 3001",
    "postinstall": "fumadocs-mdx",
    "build:docs": "node scripts/build-props.mjs && node scripts/build-demos.mjs && node scripts/build-doc-pages.mjs",
    "prebuild": "pnpm build:docs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@saasflare/ui": "workspace:*",
    "fumadocs-core": "^16.8.8",
    "fumadocs-mdx": "^15.0.0",
    "fumadocs-ui": "^16.8.8",
    "motion": "^12.0.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-hook-form": "7.74.0",
    "recharts": "^3.8.1",
    "sonner": "^2.0.0",
    "tailwindcss": "^4.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "@types/mdx": "^2.0.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react-docgen-typescript": "^2.4.0",
    "typescript": "^6.0.3"
  }
}
