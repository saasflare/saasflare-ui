{
  "name": "@saasflare/ui",
  "version": "1.0.0",
  "private": false,
  "license": "MIT",
  "description": "Saasflare UI Components Library – Standalone components built on Radix UI + Tailwind CSS",
  "repository": {
    "type": "git",
    "url": "https://github.com/saasflare/saasflare.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./styles/globals.css",
    "./globals.css": "./styles/globals.css",
    "./theme.css": "./styles/theme.css",
    "./fonts": "./fonts/index.ts",
    "./fonts/default": "./fonts/presets/default.ts",
    "./fonts/editorial": "./fonts/presets/editorial.ts",
    "./fonts/geometric": "./fonts/presets/geometric.ts",
    "./fonts/rounded": "./fonts/presets/rounded.ts",
    "./fonts/distinctive": "./fonts/presets/distinctive.ts",
    "./fonts/neutral": "./fonts/presets/neutral.ts",
    "./fonts/*": null
  },
  "files": [
    "dist",
    "styles",
    "fonts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "radix-ui": "^1.4.3",
    "@base-ui/react": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.577.0",
    "nprogress": "^0.2.0",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0"
  },
  "peerDependencies": {
    "next": "16.2.3",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "framer-motion": "^12.0.0",
    "recharts": "^3.0.0",
    "react-hook-form": "^7.0.0",
    "@hookform/resolvers": "^5.0.0",
    "zod": "^4.0.0",
    "sonner": "^2.0.0",
    "vaul": "^1.0.0",
    "react-day-picker": "^9.0.0",
    "date-fns": "^4.0.0",
    "embla-carousel-react": "^8.0.0",
    "react-resizable-panels": "^4.0.0"
  },
  "devDependencies": {
    "@types/nprogress": "^0.2.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}