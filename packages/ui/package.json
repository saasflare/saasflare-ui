{
  "name": "@saasflare/ui",
  "version": "3.11.0",
  "private": false,
  "license": "MIT",
  "description": "The Next.js UI library — App Router-aware Radix primitives with Tailwind v4 and Motion, animated by default.",
  "keywords": [
    "react",
    "nextjs",
    "next",
    "app-router",
    "rsc",
    "server-components",
    "tailwindcss",
    "tailwind-v4",
    "radix-ui",
    "motion",
    "components",
    "ui-library",
    "design-system",
    "accessible",
    "typescript"
  ],
  "homepage": "https://ui.saasflare.io",
  "bugs": {
    "url": "https://github.com/saasflare/saasflare-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/saasflare/saasflare-ui.git",
    "directory": "packages/ui"
  },
  "engines": {
    "node": ">=20"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./styles/globals.css",
    "./globals.css": "./styles/globals.css",
    "./theme.css": "./styles/theme.css",
    "./fonts": "./fonts/index.ts",
    "./fonts/default": "./fonts/presets/default.ts",
    "./fonts/editorial": "./fonts/presets/editorial.ts",
    "./fonts/geometric": "./fonts/presets/geometric.ts",
    "./fonts/rounded": "./fonts/presets/rounded.ts",
    "./fonts/distinctive": "./fonts/presets/distinctive.ts",
    "./fonts/neutral": "./fonts/presets/neutral.ts",
    "./fonts/*": null,
    "./calendar": {
      "types": "./dist/entries/calendar.d.ts",
      "import": "./dist/entries/calendar.mjs",
      "require": "./dist/entries/calendar.js"
    },
    "./carousel": {
      "types": "./dist/entries/carousel.d.ts",
      "import": "./dist/entries/carousel.mjs",
      "require": "./dist/entries/carousel.js"
    },
    "./chart": {
      "types": "./dist/entries/chart.d.ts",
      "import": "./dist/entries/chart.mjs",
      "require": "./dist/entries/chart.js"
    },
    "./command": {
      "types": "./dist/entries/command.d.ts",
      "import": "./dist/entries/command.mjs",
      "require": "./dist/entries/command.js"
    },
    "./drawer": {
      "types": "./dist/entries/drawer.d.ts",
      "import": "./dist/entries/drawer.mjs",
      "require": "./dist/entries/drawer.js"
    },
    "./input-otp": {
      "types": "./dist/entries/input-otp.d.ts",
      "import": "./dist/entries/input-otp.mjs",
      "require": "./dist/entries/input-otp.js"
    },
    "./resizable": {
      "types": "./dist/entries/resizable.d.ts",
      "import": "./dist/entries/resizable.mjs",
      "require": "./dist/entries/resizable.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "styles",
    "fonts"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.build.json && pnpm build:registry && pnpm build:llms",
    "build:registry": "node scripts/build-registry.mjs",
    "build:llms": "node scripts/build-llms.mjs",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "sonner": "^2.0.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "date-fns": "^4.0.0",
    "embla-carousel-react": "^8.0.0",
    "input-otp": "^1.4.2",
    "motion": "^12.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "next-themes": "^0.4.0",
    "react": "^19.0.0",
    "react-day-picker": "^9.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-resizable-panels": "^4.0.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.0.0",
    "vaul": "^1.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "input-otp": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "vaul": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.8",
    "esbuild-plugin-file-path-extensions": "^2.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^26.1.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vitest": "^4.1.8"
  }
}
