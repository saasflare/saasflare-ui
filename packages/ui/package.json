{
  "name": "@saasflare/ui",
  "version": "1.1.1",
  "private": false,
  "license": "MIT",
  "description": "Saasflare UI Components Library – Standalone components built on Radix UI + Tailwind CSS",
  "repository": {
    "type": "git",
    "url": "https://github.com/saasflare/saasflare-ui.git",
    "directory": "packages/ui"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org",
    "provenance": true
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./styles": "./styles/globals.css",
    "./globals.css": "./styles/globals.css",
    "./theme.css": "./styles/theme.css",
    "./fonts": "./fonts/index.ts",
    "./fonts/default": "./fonts/presets/default.ts",
    "./fonts/editorial": "./fonts/presets/editorial.ts",
    "./fonts/geometric": "./fonts/presets/geometric.ts",
    "./fonts/rounded": "./fonts/presets/rounded.ts",
    "./fonts/distinctive": "./fonts/presets/distinctive.ts",
    "./fonts/neutral": "./fonts/presets/neutral.ts",
    "./fonts/*": null,
    "./chart": {
      "types": "./dist/entries/chart.d.ts",
      "import": "./dist/entries/chart.mjs",
      "require": "./dist/entries/chart.js"
    },
    "./carousel": {
      "types": "./dist/entries/carousel.d.ts",
      "import": "./dist/entries/carousel.mjs",
      "require": "./dist/entries/carousel.js"
    }
  },
  "files": [
    "dist",
    "styles",
    "fonts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "tsup"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.7",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-direction": "^1.1.1",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.7",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.7",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.14.0",
    "tailwind-merge": "^3.5.0"
  },
  "peerDependencies": {
    "@hookform/resolvers": "^5.0.0",
    "date-fns": "^4.0.0",
    "embla-carousel-react": "^8.0.0",
    "motion": "^12.0.0",
    "next": "^15.0.0 || ^16.0.0",
    "next-themes": "^0.4.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-day-picker": "^9.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-hook-form": "^7.0.0",
    "react-resizable-panels": "^4.0.0",
    "recharts": "^3.0.0",
    "sonner": "^2.0.0",
    "vaul": "^1.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@hookform/resolvers": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "embla-carousel-react": {
      "optional": true
    },
    "motion": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "next-themes": {
      "optional": true
    },
    "react-day-picker": {
      "optional": true
    },
    "react-hook-form": {
      "optional": true
    },
    "react-resizable-panels": {
      "optional": true
    },
    "recharts": {
      "optional": true
    },
    "sonner": {
      "optional": true
    },
    "vaul": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
